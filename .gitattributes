# Every text file is LF in the repository and in every checkout, whatever core.autocrlf says: tools that write LF
# never show a file modified on Windows, and a new file type needs no line here. Only exceptions are listed below.
* text=auto eol=lf

# Windows scripts need CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Vendored as shipped.
3rdparty/GarminFitSdk/** -text

# A map's configuration key is the MD5 of its first 4096 bytes; the built-in map's bytes must not change.
src/qmapshack/map/OpenStreetMap.tms -text

# Binary whatever their content looks like.
*.ttf  binary
doc/html/**/*.inv  binary

# Generated by the doc target: collapsed in a pull request's diff.
doc/html/**  linguist-generated
